# ==============================================================================
# SENTINELNODE 2.0 - VARIÁVEIS DE AMBIENTE (VM / PRODUÇÃO LOCAL)
# ==============================================================================
# Copie este arquivo para .env se desejar customizar os padrões:
#   cp .env.example .env
# ==============================================================================

# --- Portas Expostas no Host (VM) ---
PORT=8080                  # Porta da Web UI e API do Media Gateway (http://<IP_VM>:8080)
MQTT_PORT=1883             # Porta MQTT sem criptografia (debug/desenvolvimento)
MQTT_TLS_PORT=8883         # Porta MQTT mTLS segura (usada pelos ESP32 e Agentes)
MQTT_WS_PORT=9001          # Porta MQTT WebSockets
SENTINEL_DB_PORT=5435      # Porta mapeada do PostgreSQL no Host (internamente 5432)
EMULATOR_PORT=8087         # Porta do emulador de câmera (quando ativo via profile emulator)

# --- Banco de Dados PostgreSQL ---
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=sentinel_password
POSTGRES_DB=sentinel_db

# --- Media Gateway ---
DEFAULT_DEVICE_ID=esp32-cam-01
DEFAULT_CAMERA_URL=
TOLERANCE_SECONDS=30       # Janela deslizante de gravação pós-PIR (segundos)

# --- Ingestion Engine ---
MQTT_CLIENT_ID=ingestion-engine-01
# Mapeamento de disparadores PIR para câmeras (formato: pir-id:cam-id1,cam-id2;pir-id2:cam-id3)
PIR_CAMERA_MAPPING=esp32-pir-01:esp32-cam-01

# --- Certificados mTLS (Opcional) ---
# Adicione IPs ou hostnames adicionais aos certificados mTLS gerados automaticamente
# Exemplo: EXTRA_SAN=IP:192.168.1.50,DNS:sentinel.local
EXTRA_SAN=
